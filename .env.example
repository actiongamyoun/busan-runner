# ============================================================
# 부산러너 환경변수
# ============================================================
# 이 파일을 복사해서 `.env.local`로 저장하고 값을 채우세요.
#
#   cp .env.example .env.local
#
# 그 다음 아래 값을 Supabase Dashboard에서 가져와 붙여넣으세요:
# Dashboard → Project Settings → API
# ============================================================

# Supabase 프로젝트 URL (예: https://xxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon (public) key - 브라우저에서 사용되는 공개키
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Vercel 배포 시:
# Vercel Dashboard → Project → Settings → Environment Variables
# 에서 위 두 개를 Production/Preview/Development 모두에 설정
# ============================================================
